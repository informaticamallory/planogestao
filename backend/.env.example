ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=planogestao
DB_PASS=
DB_NAME=planogestao

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do access token (minutos)
JWT_EXPIRATION=15
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Em produção (HTTPS): COOKIE_SECURE=true. Se web e API ficarem em domínios
# diferentes, use COOKIE_SAMESITE=none (exige COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

CORS_ORIGINS=http://localhost:5173

# E-mail de notificação (criação de PA, ação e sub-item). Com false, os envios ficam só registrados.
EMAIL_HABILITADO=false
# smtp = envia pelo servidor; arquivo = grava .eml na pasta EMAIL_PASTA_ARQUIVOS (homologação: nada sai).
EMAIL_MODO=smtp
EMAIL_REMETENTE=planos@suaempresa.com.br
EMAIL_REMETENTE_NOME=Planos de Ação
EMAIL_PASTA_ARQUIVOS=emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# starttls (porta 587), ssl (porta 465) ou nenhuma
SMTP_SEGURANCA=starttls
SMTP_TIMEOUT_S=20
EMAIL_MAX_TENTATIVAS=5
# Intervalo (minutos) do job que reenvia os pendentes e as falhas.
EMAIL_INTERVALO_MIN=1
# Endereço do app web, usado nos links "Acessar no sistema".
WEB_URL=http://localhost:5173

# Push no app mobile (Expo Push Service). false desliga o envio (as notificações no app continuam).
PUSH_HABILITADO=true
# Só se "Enhanced Security for Push Notifications" estiver ligado no projeto Expo.
EXPO_ACCESS_TOKEN=
